# Raspberry API (required for HTTPS sensor values and configuration transfer)
COH_RASPBERRY_API_TOKEN=
# COH_RASPBERRY_API_BASE_URL=https://example.myfritz.net

# Optional access modes: disabled, local, raspberry/http as applicable
# COH_RASPBERRY_ACCESS=http
# COH_TASMOTA_ACCESS=raspberry
# COH_WASSERLECKAGE_ACCESS=raspberry
# COH_STORAGEPRO_ACCESS=raspberry
# COH_HEIZSTAB_ACCESS=disabled

# Ampere.IQ cloud (required only for sensor source IQBoxCL)
COH_AMPERE_IQ_CL_USERNAME=
COH_AMPERE_IQ_CL_PASSWORD=

# Optional local/cloud device settings
# COH_STORAGEPRO_HOST=ASP-HSR2103J2311E08738.local
# COH_HEIZSTAB_URL=
# COH_HEIZSTAB_AUTH_ENABLED=1
# COH_HEIZSTAB_LOGIN_PATH=/auth.jsn
# COH_HEIZSTAB_PASSWORD=
# COH_HEIZSTAB_PASSWORD_FIELD=pw
# COH_HEIZSTAB_COOKIE_FILE=
# COH_HEIZSTAB_INSECURE_TLS=0
# COH_HEIZSTAB_CLOUD_BASE_URL=https://api.my-pv.com/api/v1
# COH_HEIZSTAB_CLOUD_SERIAL=
# COH_HEIZSTAB_CLOUD_API_TOKEN=

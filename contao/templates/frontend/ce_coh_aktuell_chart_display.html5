<div id="cohPanel_<?= $this->chartId ?>" class="coh-panel">

<?php
    $d = $this->data ?? [];
    //liefert Wert
    if (!function_exists('coh_v')) { function coh_v(array $d, string $id, $default = '-') { return $d[$id]['sensorValue'] ?? $default; } }
    if (!function_exists('coh_text')) {
        function coh_text($value, string $default = '-'): string
        {
            if ($value === null || $value === '') { return $default; }
            if (is_array($value)) {
                $json = json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
                return false === $json ? $default : $json;
            }
            return is_scalar($value) || $value instanceof Stringable ? (string) $value : $default;
        }
    }
    //liefert Datum
    if (!function_exists('coh_d')) { function coh_d(array $d, string $id, $default = '-') { return $d[$id]['sensorDatum'] ?? $default; } }
    //liefert Wert + Einheit
    if (!function_exists('coh_ve')) {
        function coh_ve(array $d, string $id, $default = '-') {
            $str = '';
            if (!empty($d[$id]['sensorValue'])) { $str .= coh_text($d[$id]['sensorValue'], (string) $default);
            } else { $str .= $default; }
            $str .= ' ' . ($d[$id]['sensorEinheit'] ?? '');
            return $str;
        }
    }
    // Liefert Einheit
    if (!function_exists('coh_e')) {
        function coh_e(array $d, string $id, string $default = '') { return $d[$id]['sensorEinheit'] ?? $default;}
    }

    // Liefert Titel
    if (!function_exists('coh_title')) { function coh_title(array $d, string $id, string $default = '') { return $d[$id]['sensorTitle'] ?? $default; } }

    // macht aus value float
    if (!function_exists('coh_num')) {
        function coh_num($value, $default = 0.0): float
        {
            if (!is_scalar($value) || $value === '') { return (float) $default; }
            return (float) str_replace(',', '.', (string) $value);
        }
    }
    
    if (!function_exists('coh_teile')) {
        function coh_teile( $value, int $teiler = 1000, int $round = 2): string {
        $value = is_numeric($value) ? (float) $value : 0.0;
        if ($teiler === 0) { $teiler = 1; }
        return number_format( $value / $teiler, $round, ',', '.' );
        }    
    }
    if (!function_exists('renderMinibox')) {
        function renderMinibox($class, $label, $value, $additionalValue = ''): string
        {
            return "<div class='coh-mini-box $class'>"
                . "<div class='coh-mini-label'>$label</div>"
                . "<div class='coh-mini-value'>$value</div>"
                . ($additionalValue !== '' ? "<div class='coh-mini-value'>$additionalValue</div>" : '')
                . '</div>';
        }
    }
    if (!function_exists('renderArray')) {
        function renderArray(array $values): void
        {
            foreach ($values as $key => $value) {
                if (is_array($value)) {
                    echo "<div><strong>$key:</strong></div>";
                    echo "<div style='margin-left:15px'>";
                    renderArray($value);
                    echo '</div>';
                } else {
                    echo "<div>$key: $value</div>";
                }
            }
        }
    }
    
//var_dump($d);
        $live = coh_v($d, 'IQ_Live', []);   // live Daten Iq_box
/*
        'pvPower' => int 4600
          'housePower' => int -400
          'gridPower' => int -4200
          'batteryPower' => int 0
          'heatingRodPower' => int 0
          'batterySoc' => int 100

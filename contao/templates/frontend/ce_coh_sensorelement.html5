<?php
    function renderArray($arr, string $prefix = '') {
        foreach ($arr as $key => $value) {
            $escapedKey = str_replace(["\\", "'"], ["\\\\", "\\'"], (string) $key);
            $path = $prefix === '' ? (string) $key : $prefix . "['" . $escapedKey . "']";
            if (is_array($value)) {
                echo '<div><strong>' . htmlspecialchars($path, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . ':</strong></div>';
                echo "<div style='margin-left:15px'>";
                renderArray($value, $path);
                echo "</div>";
            } else {
                $displayValue = $value === null ? 'null' : (is_bool($value) ? ($value ? 'true' : 'false') : (string) $value);
                echo '<div><span class="coh-sensor-key">' . htmlspecialchars($path, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8')
                    . '</span> : ' . htmlspecialchars($displayValue, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</div>';
            }
        }
    }
?>
<div class="coh-sensor-select">

    <input type="text"
        id="sensorFilter"
        placeholder="Sensor suchen (* möglich) "
        style="width:500px;margin-bottom:10px;">
    <form method="get">
        <div id="sensorList">
            <?php foreach ($this->allSensors  as $sensor): ?>
                <label class="sensorItem">
                <input type="checkbox" name="<?php echo $this->fieldName; ?>[]" value="<?php echo $sensor['sensorID']; ?>"
                    <?php if (in_array($sensor['sensorID'], $this->selectedSensors)): ?> checked <?php endif; ?> >
                                <?php echo $sensor['sensorTitle']; ?>
                                (<?php echo $sensor['sensorID']; ?>)
                </label>
            <?php endforeach; ?>
        </div>
        <br>
        <button type="submit">Sensoren anzeigen</button>
    </form>
</div>
<hr>
<div class="coh-sensor-result">
    <?php foreach ($this->sensors as $sensor): ?>
        <div class="coh-sensor-item" style="margin-bottom:20px">
            <h3>
            <?php echo $sensor['sensorTitle']; ?>
            </h3>
            <table border="1" cellpadding="5">
                <tr>
                    <td><b>SensorID</b></td>
                    <td><?php echo $sensor['sensorID']; ?></td>
                </tr>
                <tr>
                    <td><b>Sensortitel</b></td>
                    <td><?php echo $sensor['sensorTitle']; ?></td>
                </tr>
                <tr>
                    <td><b>Letzter Wert</b></td>
                    <td>
                        <?php
                            $sensorValue = $sensor['sensorValue'] ?? null;
                            $sensorValueArray = null;

                            if (is_array($sensorValue)) {
                                $sensorValueArray = $sensorValue;
                            } elseif (is_object($sensorValue)) {
                                $sensorValueArray = (array) $sensorValue;
                            } elseif (is_string($sensorValue)) {
                                $decodedValue = json_decode($sensorValue, true);
                                if (json_last_error() === JSON_ERROR_NONE && is_array($decodedValue)) {
                                    $sensorValueArray = $decodedValue;
                                }
                            }
                        ?>
                        <?php if ($sensorValueArray !== null): ?>
                            <div class="coh-sensor-array">
                                <?php renderArray($sensorValueArray, 'sensorValueArray'); ?>
                            </div>
                        <?php else: ?>
                            <?= htmlspecialchars((string) $sensorValue, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                            <?= htmlspecialchars((string) ($sensor['sensorEinheit'] ?? ''), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                        <?php endif; ?>
                    </td>
                </tr>
                <tr>
                    <td><b>Einheit</b></td>
                    <td><?= $sensor['sensorEinheit'] ?></td>
                </tr>
                <tr>
                    <td><b>outputMode</b></td>
                    <td><?= $sensor['outputMode'] ?></td>
                </tr>
                <tr>
                    <td><b>sensorLokalId</b></td>
                    <td><?= $sensor['sensorLokalId'] ?></td>
                </tr>
                <tr>
                    <td><b>sensorValueType</b></td>
                    <td><?= $sensor['sensorValueType'] ?></td>
                </tr>
                <tr>
                    <td><b>Zeit</b></td>
                    <td><?php echo $sensor['date']; ?></td>
                </tr>
            </table>
        </div>
    <?php endforeach; ?>
</div>

<style>
.sensorItem {
    display: block;
    margin: 0 0 4px;
    line-height: 1.35;
}

.sensorItem input[type="checkbox"] {
    margin: 0 6px 0 0;
    vertical-align: middle;
}
</style>

<script>
document.getElementById('sensorFilter').addEventListener('keyup', function(){
    let filter = this.value.toLowerCase();
    /* Wildcard entfernen */
    filter = filter.replace(/\*/g,'');
    const items = document.querySelectorAll('.sensorItem');
    items.forEach(function(item){
        const text = item.textContent.toLowerCase();
        const id = item.querySelector('input').value.toLowerCase();
        if(text.includes(filter) || id.includes(filter)) {
            item.style.display = "block";
        } else {
            item.style.display = "none";
        }
    });
});
</script>

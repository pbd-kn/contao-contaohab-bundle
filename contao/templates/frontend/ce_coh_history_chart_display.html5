<?php use Contao\StringUtil; ?>


<div class="chart-wrapper actuell-history-container coh-history">
<style>
.coh_history_wrapper:has(> .coh-history) {
  container-type: inline-size;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.5rem;
  align-items: start;
}
.coh-history.chart-wrapper {
  box-sizing: border-box;
  width: 100%;
  max-width: none;
  min-width: 0;
  grid-column: 1 / -1;
  flex: 0 0 100%;
  margin: 0 0 1.5rem;
  padding: clamp(1rem, 2.5vw, 2rem);
  background: #fff;
  color: #263747;
  border: 1px solid #dce5ed;
  border-radius: 12px;
  box-shadow: 0 3px 12px rgba(25, 50, 75, .05);
}
.coh_history_wrapper > .coh-history { margin-bottom: 0; }
/* Entscheidend ist der Platz im Inhaltsbereich, nicht die Fensterbreite. */
@container (min-width: 1100px) {
  .coh_history_wrapper > .coh-history {
    grid-column: auto;
  }
}
.coh-history .coh-history-title {
  margin: 0 0 1.25rem;
  font-size: 1.3rem;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.coh-history .chart-container {
  position: relative;
  width: 100%;
  min-width: var(--coh-chart-min-width, 440px);
  height: clamp(340px, 48vh, 480px);
}
/* Das Theme setzt canvas auf height:auto !important. Chart.js braucht
   hier die feste Hoehe seines responsiven Containers. */
.coh-history.chart-wrapper.actuell-history-container .chart-container canvas {
  width: 100% !important;
  height: 100% !important;
}
.coh-history .coh-history-plot {
  overflow-x: auto;
  margin-top: 1.25rem;
}
.coh-history .coh-history-controls {
  display: grid;
  gap: 1rem;
  padding: 1rem;
  background: #f4f7fa;
  border-radius: 8px;
}
.coh-history .coh-history-date,
.coh-history .coh-history-navigation {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .5rem .75rem;
}
.coh-history .coh-history-date small {
  flex-basis: 100%;
  color: #586b7c;
  line-height: 1.5;
}
.coh-history .coh-history-controls :is(input[type="date"], select, button) {
  box-sizing: border-box;
  min-height: 40px;
  max-width: 100%;
  margin: 0;
  padding: .45rem .7rem;
  border: 1px solid #b8c8d6;
  border-radius: 6px;
  background: #fff;
  color: #263747;
  font: inherit;
  line-height: 1.4;
}
.coh-history .coh-history-controls button { cursor: pointer; }
.coh-history .coh-history-controls button:hover { background: #e6eef6; }
.coh-history .coh-history-controls :is(input, select, button):focus-visible {
  outline: 2px solid #0033a0;
  outline-offset: 2px;
}
.coh-history .coh-history-range { font-weight: 600; }
.coh-history .coh-chart-zoom {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .5rem;
  margin-top: 1rem;
}
.coh-history .coh-chart-zoom button {
  padding: .45rem .7rem;
  border: 1px solid #b8c8d6;
  border-radius: 6px;
  background: #fff;
  color: #263747;
  font: inherit;
  cursor: pointer;
}
.coh-history .coh-chart-zoom button:focus-visible {
  outline: 2px solid #0033a0;
  outline-offset: 2px;
}
.coh-history .coh-chart-zoom small { color: #586b7c; }
.coh-history .chart-periods {
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
}
.coh-history .chart-periods legend {
  margin-bottom: .5rem;
  padding: 0;
  font-size: 1rem;
  font-weight: 600;
}
@media (max-width: 600px) {
  .coh-history .coh-history-range { order: 1; flex-basis: 100%; }
  .coh-history .chart-periods select { width: 100%; }
}

</style>

<?php
$headline = StringUtil::deserialize($this->headline);
$chartTitle = 'Sensorwerte über Zeit';

if (is_string($headline)) {
    $chartTitle = $headline;
} elseif (is_array($headline) && isset($headline['value'])) {
    $chartTitle = $headline['value'];
}
?>

<h2 class="coh-history-title"><?= htmlspecialchars($chartTitle) ?></h2>
<?php $this->insert('coh_history_chart_controls', $this->getData()); ?>

<?php if ($chartdataRaw = $this->chartdata): ?>
  <div class="coh-chart-zoom" id="<?= $this->chartId ?>_zoom" role="group" aria-label="Diagramm-Zoom">
    <button type="button" data-zoom="in">Vergrößern +</button>
    <button type="button" data-zoom="out">Verkleinern −</button>
    <button type="button" data-zoom="reset">Zoom zurücksetzen</button>
    <small>Zeitbereich mit gedrückter linker Maustaste auswählen oder Umschalt + Mausrad verwenden.</small>
  </div>
  <div class="coh-history-plot" role="region" aria-label="Diagramm, bei Bedarf horizontal scrollbar" tabindex="0">
  <div class="chart-container">
    <canvas id="<?= $this->chartId ?>"></canvas>
  </div>
  </div>
<script>
document.addEventListener('DOMContentLoaded', () => {

  luxon.Settings.defaultLocale = 'de';

  const chartData = <?= $chartdataRaw ?>;
  const ctx = document.getElementById("<?= $this->chartId ?>").getContext("2d");
  const axisCount = Object.keys(chartData.axes ?? {}).length;
  // Auch bei vielen Skalen bleibt genug Platz fuer die eigentliche Kurve.
  ctx.canvas.parentElement.style.setProperty('--coh-chart-min-width',
    `${440 + Math.max(0, axisCount - 2) * 100}px`);
  const chartType = chartData.xUnit === 'day' ? 'line' : 'bar';
  if (chartType === 'bar') {
    chartData.datasets.forEach(dataset => {
      dataset.data.forEach(point => {
        const date = typeof point.x === 'number'
          ? luxon.DateTime.fromMillis(point.x)
          : luxon.DateTime.fromISO(point.x, { setZone: true });
        const unit = getTimeConfig(chartData.xUnit).unit;
        const start = date.startOf(unit);
        const end = start.plus({ [unit]: 1 });
        point.x = (start.toMillis() + end.toMillis()) / 2;
      });
      dataset.maxBarThickness = 36;
      dataset.barPercentage = 0.85;
      dataset.categoryPercentage = 0.8;
      // Nullwerte bleiben als schmale, mit der Maus erreichbare Markierung
      // sichtbar. Der Messwert selbst bleibt unveraendert bei null.
      const axis = chartData.axes?.[dataset.yAxisID];
      if (axis?.binary || axis?.beginAtZero) {
        dataset.minBarLength = 6;
      }
    });
  }

  function getTimeConfig(unit) {
    if (chartData.xDisplayUnit === 'hour') {
      return { unit: 'hour', displayFormats: { hour: 'HH:mm' }, tooltipFormat: 'ccc dd.MM.yyyy HH:mm' };
    }

    switch (unit) {
      case 'day':
      case 'week':
        return { unit: 'day', displayFormats: { day: 'ccc dd.MM' }, tooltipFormat: 'cccc dd.MM.yyyy HH:mm' };
      case 'month':
        return { unit: 'day', displayFormats: { day: 'dd.MM' }, tooltipFormat: 'dd.MM.yyyy' };
      case 'year':
        return { unit: 'month', displayFormats: { month: 'MMM yyyy' }, tooltipFormat: 'LLLL yyyy' };
      default:
        return { unit: 'day' };
    }
  }

  const scales = {
    x: {
      type: 'time',
      min: chartData.rangeMin,
      max: chartData.rangeMax,
      time: getTimeConfig(chartData.xUnit),
      grid: { drawOnChartArea: false },
      title: { display: true, text: 'Zeit' },
      ticks: { autoSkip: true, maxTicksLimit: 12 }
    }
  };

  let axisIndex = 0;

  for (const [axisId, info] of Object.entries(chartData.axes ?? {})) {

    const color = info.color || '#000';
    const unit  = info.unit || '';

    const position = axisIndex % 2 === 0 ? 'left' : 'right';

    scales[axisId] = {
      type: 'linear',
      beginAtZero: info.beginAtZero === true,
      position: position,
      weight: axisIndex,
      display: true,
      ...(info.binary ? { min: 0, max: 1 } : {}),

      title: {
        display: (info.title || unit) !== '',
        text: info.title || unit,
        color: color
      },

      ticks: {
        color: color,
        padding: 5,
        ...(info.binary ? { stepSize: 1, autoSkip: false } : {}),
        callback: function(value) {
          if (info.binary) return value === 0 ? '0 (Nein)' : value === 1 ? '1 (Ja)' : '';
          const v = Math.round(value * 100) / 100;
          return unit ? v + ' ' + unit : v;
        }
      },

      grid: {
        drawOnChartArea: axisIndex === 0 && !info.binary,
        color: 'rgba(0,0,0,0.05)'
      },

      offset: !info.binary
    };

    axisIndex++;
  }

  function syncAxisVisibility(chartInstance) {
    for (const axisId of Object.keys(chartData.axes ?? {})) {
      chartInstance.options.scales[axisId].display = chartInstance.data.datasets.some(
        (dataset, index) => dataset.yAxisID === axisId && chartInstance.isDatasetVisible(index)
      );
    }
  }

  const differenceFormat = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 2 });

  function generateIntervalLegendLabels(chartInstance) {
    const labels = Chart.defaults.plugins.legend.labels.generateLabels(chartInstance);
    // Der Intervallwert bleibt auch beim Hineinzoomen auf den gewaehlten
    // Tag/die Woche/den Monat/das Jahr bezogen.
    const min = Date.parse(chartData.rangeMin);
    const max = Date.parse(chartData.rangeMax);

    return labels.map(item => {
      const dataset = chartInstance.data.datasets[item.datasetIndex];
      let first = null;
      let last = null;
      let count = 0;
      let total = 0;
      let incomplete = false;
      const sumCounterIncrements = dataset.historyAggregation === 'counter' && chartData.xUnit !== 'day';

      // Nur gueltige Y-Werte im dargestellten Zeitintervall beruecksichtigen.
      // Nach Zeit vergleichen, damit auch unsortierte Daten korrekt bleiben.
      for (const point of dataset.data) {
        const x = typeof point?.x === 'number' ? point.x : Date.parse(point?.x);
        const y = point?.y;
        if (!Number.isFinite(x) || x < min || x > max) continue;
        if (!Number.isFinite(y)) {
          incomplete = true;
          continue;
        }
        if (first === null || x < first.x) first = { x, y };
        if (last === null || x >= last.x) last = { x, y };
        count++;
        total += y;
      }

      const unit = chartData.axes?.[dataset.yAxisID]?.unit || '';
      // Die API liefert Zaehler am Tag kumuliert ab Mitternacht, sonst
      // bereits als Zuwachs je Tag/Monat. Deren Summe ist die Veraenderung
      // des Zaehlerstands im gesamten Intervall, auch bei nur einem Balken.
      const value = sumCounterIncrements
        ? (count > 0 && !incomplete ? total : null)
        : (count >= 2 ? last.y - first.y : null);
      const difference = value !== null ? differenceFormat.format(value) : '–';
      item.text = `${item.text} · Δ ${difference}${value !== null && unit ? ' ' + unit : ''}`;
      return item;
    });
  }

  // Nur die Darstellung beim Zeichnen ändern; Farben, Legende und Daten
  // bleiben unverändert, auch nach Ausblenden oder einem Chart-Update.
  let highlightedDataset = null;
  let pointerOverLegend = false;
  let originalElementOptions = [];
  const periodSeparators = {
    id: 'cohPeriodSeparators',
    beforeDatasetsDraw(chartInstance) {
      const axis = chartInstance.scales.x;
      const area = chartInstance.chartArea;
      const adapter = axis._adapter;
      const unit = getTimeConfig(chartData.xUnit).unit;
      let boundary = adapter.startOf(axis.min, unit);
      const ctx = chartInstance.ctx;
      ctx.save();
      ctx.beginPath();
      ctx.rect(area.left, area.top, area.right - area.left, area.bottom - area.top);
      ctx.clip();
      ctx.beginPath();
      ctx.strokeStyle = 'rgba(65, 85, 110, 0.35)';
      ctx.lineWidth = 1;
      // Alle Balken sind in der Mitte ihres Kalenderabschnitts ausgerichtet.
      // Die Trennlinien markieren dessen tatsächliche Grenzen.
      for (let count = 0; boundary <= axis.max && count < 2000; count++) {
        const next = adapter.add(boundary, 1, unit);
        const position = boundary;
        const x = axis.getPixelForValue(position);
        if (x > area.left && x < area.right) {
          ctx.moveTo(x, area.top);
          ctx.lineTo(x, area.bottom);
        }
        if (next <= boundary) break;
        boundary = next;
      }
      ctx.stroke();
      ctx.restore();
    }
  };
  const legendHighlight = {
    id: 'cohLegendHighlight',
    afterEvent(chartInstance, args) {
      const { type, x, y } = args.event;
      if (!['mousemove', 'mouseout', 'click'].includes(type)) return;
      const legend = chartInstance.legend;
      const overLegend = type !== 'mouseout' && !!legend?.options.display &&
        x >= legend.left - 2 && x <= legend.right + 2 &&
        y >= legend.top - 2 && y <= legend.bottom + 2;
      if (pointerOverLegend !== overLegend) {
        pointerOverLegend = overLegend;
        args.changed = true;
      }
      if (overLegend) {
        // Chart.js kann außerhalb der Plotfläche den letzten Messpunkt
        // aktiv lassen. Über der Legende gehört dieser Tooltip nicht dazu.
        chartInstance.setActiveElements([]);
        chartInstance.tooltip?.setActiveElements([], { x, y });
        args.changed = true;
      }
      let next = null;
      if (type !== 'mouseout' && legend?.options.display) {
        // Hitbox umfasst Farbkästchen, Zwischenraum und Beschriftung.
        // Bei jeder Bewegung prüfen, auch innerhalb desselben Eintrags.
        const itemIndex = legend.legendHitBoxes.findIndex(box =>
          x >= box.left - 2 && x <= box.left + box.width + 2 &&
          y >= box.top - 2 && y <= box.top + box.height + 2
        );
        const index = legend.legendItems[itemIndex]?.datasetIndex;
        if (index !== undefined && chartInstance.isDatasetVisible(index)) next = index;
      }
      if (highlightedDataset !== next) {
        highlightedDataset = next;
        args.changed = true;
      }
    },
    beforeTooltipDraw() {
      return !pointerOverLegend;
    },
    beforeDatasetDraw(chartInstance, args) {
      chartInstance.ctx.save();
      originalElementOptions = [];
      if (highlightedDataset === null) return;
      if (args.index !== highlightedDataset) {
        chartInstance.ctx.globalAlpha *= 0.18;
        return;
      }
      const elements = args.meta.dataset ? [args.meta.dataset] : args.meta.data;
      elements.forEach(element => {
        originalElementOptions.push([element, element.options]);
        element.options = {
          ...element.options,
          borderWidth: Math.max(3, (Number(element.options.borderWidth) || 1) + 2)
        };
      });
    },
    afterDatasetDraw(chartInstance) {
      originalElementOptions.forEach(([element, options]) => { element.options = options; });
      originalElementOptions = [];
      chartInstance.ctx.restore();
    }
  };

  const chart = new Chart(ctx, {
    plugins: [periodSeparators, legendHighlight],
    // Tag: zeitlicher Linienverlauf. Woche, Monat und Jahr:
    // senkrechte Balken entlang der Zeitachse.
    type: chartType,
    data: {
      datasets: chartData.datasets
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,

      // Bei Balken zaehlt die getroffene Flaeche, nicht der Abstand zum
      // Mittelpunkt eines benachbarten (eventuell viel hoeheren) Balkens.
      interaction: { mode: 'nearest', axis: 'xy', intersect: chartType === 'bar' },

      scales,

      elements: {
        line: { borderWidth: 1 },
        bar: {
          borderWidth: 1,
          borderSkipped: false
        },
        point: {
          radius: 0.75,
          pointStyle: 'circle',
          backgroundColor: '#fff',
          borderColor: '#333',
          borderWidth: 1,
          hoverRadius: 4
        }
      },

      plugins: {
        zoom: {
          limits: { x: { min: 'original', max: 'original', minRange: 60000 } },
          zoom: {
            mode: 'x',
            wheel: { enabled: true, modifierKey: 'shift', speed: 0.15 },
            drag: {
              enabled: true,
              threshold: 10,
              backgroundColor: 'rgba(0, 51, 160, 0.12)',
              borderColor: '#0033a0',
              borderWidth: 1
            }
          }
        },
        legend: {
          display: true,
          position: 'top',
          align: 'start',
          labels: {
            boxWidth: 18, boxHeight: 12, padding: 18, font: { size: 13 },
            generateLabels: generateIntervalLegendLabels
          },
          onClick: (event, legendItem, legend) => {
            const chartInstance = legend.chart;
            const index = legendItem.datasetIndex;
            chartInstance.setDatasetVisibility(index, !chartInstance.isDatasetVisible(index));
            highlightedDataset = chartInstance.isDatasetVisible(index) ? index : null;
            syncAxisVisibility(chartInstance);
            chartInstance.update();

          }
        },

        title: {
          display: false,
          text: <?= json_encode($chartTitle) ?>
        },

        tooltip: {
          callbacks: {
            label: ctx => {
              const label = ctx.dataset.label || '';
              const value = ctx.parsed.y;
              const axisId = ctx.dataset.yAxisID;
              if (chartData.axes?.[axisId]?.binary && (value === 0 || value === 1)) {
                return `${label}: ${value} (${value === 1 ? 'Ja' : 'Nein'})`;
              }
              const unit = chartData.axes?.[axisId]?.unit || '';
              return `${label}: ${value}${unit ? ' ' + unit : ''}`;
            }
          }
        }
      }
    }
  });

  document.getElementById("<?= $this->chartId ?>_zoom").addEventListener('click', event => {
    const button = event.target.closest('button[data-zoom]');
    if (!button) return;
    if (button.dataset.zoom === 'reset') {
      chart.resetZoom();
    } else {
      chart.zoom({ x: button.dataset.zoom === 'in' ? 1.5 : 1 / 1.5, y: 1 });
    }
  });

});
</script>

<?php else: ?>
  <p><em>Keine Daten vorhanden</em></p>
<?php endif; ?>
</div>

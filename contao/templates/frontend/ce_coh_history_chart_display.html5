<?php use Contao\StringUtil; ?>


<div class="chart-wrapper actuell-history-container">
<style>
.chart-wrapper {
  width: 100%;
}

/* 🔥 DAS IST DER FIX */
.chart-container {
  position: relative;
  width: 100%;
  height: clamp(300px, 50vh, 600px);
}

.chart-periods, .chart-series-controls {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem 1rem;
  margin: .75rem 0;
}

.chart-series-controls label {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  cursor: pointer;
}

</style>

<?php
$headline = StringUtil::deserialize($this->headline);
$chartTitle = 'Sensorwerte über Zeit';

if (is_string($headline)) {
    $chartTitle = $headline;
} elseif (is_array($headline) && isset($headline['value'])) {
    $chartTitle = $headline['value'];
}
?>

<form method="get">               
  <?php foreach ($_GET as $key => $value): ?>
    <?php if (str_starts_with($key, 'unit_chart_') || str_starts_with($key, 'value_chart_') || str_starts_with($key, 'periods_chart_')): ?>
      <?php if ($key !== $this->unitField && $key !== $this->valueField && $key !== $this->periodsField): ?>
        <?php foreach ((array) $value as $hiddenValue): ?>
          <input type="hidden" name="<?= htmlspecialchars($key) ?><?= is_array($value) ? '[]' : '' ?>" value="<?= htmlspecialchars($hiddenValue) ?>">
        <?php endforeach; ?>
      <?php endif; ?>
    <?php endif; ?>
  <?php endforeach; ?>

  <div style="display:flex; flex-wrap:wrap; gap:.5rem; align-items:center">
    <select class="button button-tonal-md" style="margin-right: 10px;" name="<?= $this->unitField ?>" onchange="this.form.submit()">
      <option value="day" <?= $this->currentUnit === 'day' ? 'selected' : '' ?>>Tag</option>
      <option value="week" <?= $this->currentUnit === 'week' ? 'selected' : '' ?>>Woche</option>
      <option value="month" <?= $this->currentUnit === 'month' ? 'selected' : '' ?>>Monat</option>
      <option value="year" <?= $this->currentUnit === 'year' ? 'selected' : '' ?>>Jahr</option>
    </select>

    <button class="button button-tonal-md" type="submit"
      name="<?= $this->valueField ?>"
      value="<?= htmlspecialchars($this->previousValue) ?>">
      ←
    </button>

    <span class="button button-tonal-md" style="margin: 0 0.5rem;">
      <?= $this->rangeLabel ?>
    </span>

    <button class="button button-tonal-md" type="submit"
      name="<?= $this->valueField ?>"
      value="<?= htmlspecialchars($this->nextValue) ?>">
      →
    </button>
  </div>
  <fieldset class="chart-periods">
    <legend><?= ['day' => 'Tag', 'week' => 'Woche', 'month' => 'Monat', 'year' => 'Jahr'][$this->currentUnit] ?> auswählen</legend>
    <select class="button button-tonal-md" name="<?= htmlspecialchars($this->periodsField) ?>[]" onchange="this.form.submit()">
      <?php foreach ($this->periodOptions as $option): ?>
        <option value="<?= htmlspecialchars($option['value']) ?>" <?= $option['checked'] ? 'selected' : '' ?>>
          <?= htmlspecialchars($option['label']) ?>
        </option>
      <?php endforeach; ?>
    </select>
  </fieldset>
</form>

<?php if ($chartdataRaw = $this->chartdata): ?>
  <!-- 🔥 NEU: eigener Chart-Container -->
  <div class="chart-container">
    <canvas id="<?= $this->chartId ?>"></canvas>
  </div>
  <div id="<?= $this->chartId ?>_series" class="chart-series-controls" aria-label="Messwerte auswählen"></div>
<script>
document.addEventListener('DOMContentLoaded', () => {

  luxon.Settings.defaultLocale = 'de';

  const chartData = <?= $chartdataRaw ?>;
  const ctx = document.getElementById("<?= $this->chartId ?>").getContext("2d");
  const chartType = chartData.xUnit === 'day' ? 'line' : 'bar';
  if (chartType === 'bar') {
    chartData.datasets.forEach(dataset => {
      dataset.maxBarThickness = 36;
      dataset.barPercentage = 0.85;
      dataset.categoryPercentage = 0.8;
      // Nullwerte bleiben als schmale, mit der Maus erreichbare Markierung
      // sichtbar. Der Messwert selbst bleibt unveraendert bei null.
      const axis = chartData.axes?.[dataset.yAxisID];
      if (axis?.binary || axis?.beginAtZero) {
        dataset.minBarLength = 6;
      }
    });
  }

  function getTimeConfig(unit) {
    if (chartData.xDisplayUnit === 'hour') {
      return { unit: 'hour', displayFormats: { hour: 'HH:mm' }, tooltipFormat: 'ccc dd.MM.yyyy HH:mm' };
    }

    switch (unit) {
      case 'day':
      case 'week':
        return { unit: 'day', displayFormats: { day: 'ccc dd.MM' }, tooltipFormat: 'cccc dd.MM.yyyy HH:mm' };
      case 'month':
        return { unit: 'day', displayFormats: { day: 'dd.MM' }, tooltipFormat: 'dd.MM.yyyy' };
      case 'year':
        return { unit: 'month', displayFormats: { month: 'MMM yyyy' }, tooltipFormat: 'LLLL yyyy' };
      default:
        return { unit: 'day' };
    }
  }

  const scales = {
    x: {
      type: 'time',
      min: chartData.rangeMin,
      max: chartData.rangeMax,
      time: getTimeConfig(chartData.xUnit),
      title: { display: true, text: 'Zeit' },
      ticks: { autoSkip: true, maxTicksLimit: 12 }
    }
  };

  let axisIndex = 0;

  for (const [axisId, info] of Object.entries(chartData.axes ?? {})) {

    const color = info.color || '#000';
    const unit  = info.unit || '';

    const position = axisIndex % 2 === 0 ? 'left' : 'right';

    scales[axisId] = {
      type: 'linear',
      beginAtZero: info.beginAtZero === true,
      position: position,
      weight: axisIndex,
      display: true,
      ...(info.binary ? { min: 0, max: 1 } : {}),

      title: {
        display: (info.title || unit) !== '',
        text: info.title || unit,
        color: color
      },

      ticks: {
        color: color,
        padding: 5,
        ...(info.binary ? { stepSize: 1, autoSkip: false } : {}),
        callback: function(value) {
          if (info.binary) return value === 0 ? '0 (Nein)' : value === 1 ? '1 (Ja)' : '';
          const v = Math.round(value * 100) / 100;
          return unit ? v + ' ' + unit : v;
        }
      },

      grid: {
        drawOnChartArea: axisIndex === 0 && !info.binary,
        color: 'rgba(0,0,0,0.05)'
      },

      offset: !info.binary
    };

    axisIndex++;
  }

  function syncAxisVisibility(chartInstance) {
    for (const axisId of Object.keys(chartData.axes ?? {})) {
      chartInstance.options.scales[axisId].display = chartInstance.data.datasets.some(
        (dataset, index) => dataset.yAxisID === axisId && chartInstance.isDatasetVisible(index)
      );
    }
  }

  const chart = new Chart(ctx, {
    // Tag: zeitlicher Linienverlauf. Woche, Monat und Jahr:
    // senkrechte Balken entlang der Zeitachse.
    type: chartType,
    data: {
      datasets: chartData.datasets
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,

      // Bei Balken zaehlt die getroffene Flaeche, nicht der Abstand zum
      // Mittelpunkt eines benachbarten (eventuell viel hoeheren) Balkens.
      interaction: { mode: 'nearest', axis: 'xy', intersect: chartType === 'bar' },

      scales,

      elements: {
        line: { borderWidth: 1 },
        bar: {
          borderWidth: 1,
          borderSkipped: false
        },
        point: {
          radius: 0.75,
          pointStyle: 'circle',
          backgroundColor: '#fff',
          borderColor: '#333',
          borderWidth: 1,
          hoverRadius: 4
        }
      },

      plugins: {
        legend: {
          display: true,
          position: 'top',
          align: 'start',
          onClick: (event, legendItem, legend) => {
            const chartInstance = legend.chart;
            const index = legendItem.datasetIndex;
            chartInstance.setDatasetVisibility(index, !chartInstance.isDatasetVisible(index));
            syncAxisVisibility(chartInstance);
            chartInstance.update();

            const checkbox = document.querySelector(
              '#<?= $this->chartId ?>_series input[data-dataset-index="' + index + '"]'
            );
            if (checkbox) {
              checkbox.checked = chartInstance.isDatasetVisible(index);
            }
          }
        },

        title: {
          display: true,
          text: <?= json_encode($chartTitle) ?>
        },

        tooltip: {
          callbacks: {
            label: ctx => {
              const label = ctx.dataset.label || '';
              const value = ctx.parsed.y;
              const axisId = ctx.dataset.yAxisID;
              if (chartData.axes?.[axisId]?.binary && (value === 0 || value === 1)) {
                return `${label}: ${value} (${value === 1 ? 'Ja' : 'Nein'})`;
              }
              const unit = chartData.axes?.[axisId]?.unit || '';
              return `${label}: ${value}${unit ? ' ' + unit : ''}`;
            }
          }
        }
      }
    }
  });

  const seriesControls = document.getElementById("<?= $this->chartId ?>_series");
  chart.data.datasets.forEach((dataset, index) => {
    const label = document.createElement('label');
    const checkbox = document.createElement('input');
    const text = document.createElement('span');
    checkbox.type = 'checkbox';
    checkbox.dataset.datasetIndex = index;
    checkbox.checked = chart.isDatasetVisible(index);
    checkbox.addEventListener('change', () => {
      chart.setDatasetVisibility(index, checkbox.checked);
      syncAxisVisibility(chart);
      chart.update();
    });
    text.textContent = dataset.label;
    text.style.color = dataset.borderColor;
    label.append(checkbox, text);
    seriesControls.append(label);
  });

});
</script>

<?php else: ?>
  <p><em>Keine Daten vorhanden</em></p>
<?php endif; ?>
</div>

<?php
$escape = static fn (mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$catalog = is_array($this->writeCatalog ?? null) ? $this->writeCatalog : [];
$executable = is_array($this->executableIds ?? null) ? $this->executableIds : [];
$selected = (string) ($this->writeSelected ?? '');
$preview = is_array($this->writePreview ?? null) ? $this->writePreview : null;
$result = is_array($this->writeResult ?? null) ? $this->writeResult : null;
$descriptions = is_array($this->valueDescriptions ?? null) ? $this->valueDescriptions : [];    // enthält die werte für tooltipp
$dialogActive = $selected !== '' || $preview !== null || $result !== null || !empty($this->writeError);
$formatValue = static function (array $item) use ($escape): string {
    $value = $item['Wert'] ?? '-';
    $unit = trim((string) ($item['Einheit'] ?? ''));
    return $escape($value) . ($unit !== '' ? ' <span class="km271-unit">' . $escape($unit) . '</span>' : '');
};
$localIdFor = static function (string $key) use ($catalog): ?string {
    if (isset($catalog[$key])) {
        return $key;
    }
    $aliases = ['Frostschutz_ab' => 'HK1_Frostschutz_ab'];
    return isset($aliases[$key], $catalog[$aliases[$key]]) ? $aliases[$key] : null;
};

$renderCards = static function (array $items, array $settings = []) use ($escape, $formatValue, $localIdFor, $executable, $descriptions): void {
    foreach ($items as $key => $item) {
        $localId = $localIdFor((string) $key);
        $editable = $localId !== null && in_array($localId, $executable, true);
        // Bestehende Beschreibung ermitteln.
        $description = $descriptions[(string) $key] ?? '';
        if (!isset($descriptions[(string) $key]) && str_starts_with((string) $key, 'Störung_')) {
            $description = 'Statusmeldung der Buderus-Regelung. Der Wert 0 bedeutet keine Störung; ein anderer Wert weist auf eine aktive oder gespeicherte Störung hin.';
        }
        // Zusätzliche Info anhängen oder Beschreibung ersetzen.
        $Tooltip = trim((string) ($settings[$key]['Tooltip'] ?? $settings[$key]['Tooltip'] ?? ''));
        if ($Tooltip !== '') {
            if (str_starts_with($Tooltip, '.')) {
                $description = trim($description . ' ' . ltrim(substr($Tooltip, 1)));
            } else {
                $description = $Tooltip;
            }
        }
        // CSS-Klasse für bearbeitbare Werte ergänzen.
        $cardClass = 'coh-mini-box km271-card';
        if ($editable) { $cardClass .= ' is-editable'; }
        echo '<article class="' . $cardClass . '">';
        echo '<div class="km271-card-heading">';
            // SensorTitel mit optionalem Tooltip.
            if ($description !== '') {
                echo '<span class="km271-tooltip" tabindex="0"';
                echo ' title="' . $escape($description) . '"';
                echo ' data-tooltip="' . $escape($description) . '">';
            } else {
                echo '<span>';
            }
            echo $escape($settings[$key]['Titel'] ?? str_replace('_', ' ', (string) $key));   // headline aus konfiguration
            if ($description !== '') { echo '<span class="km271-tooltip" aria-hidden="true">ⓘ</span>'; }
            echo '</span>';
            // Schaltfläche zum Ändern des Wertes.
            if ($editable) {
                $label = $escape($item['Name'] ?? $localId);
                echo '<button type="button" class="km271-edit" data-km271-edit';
                echo ' data-local-id="' . $escape($localId) . '"';
                echo ' data-label="' . $label . '"';
                echo ' data-current="' . $escape($item['Wert'] ?? '') . '"';
                echo ' aria-label="' . $label . ' ändern"';
                echo ' title="Wert ändern">✎</button>';
            }
        echo '</div>';
        // Sensorwert und Zeitpunkt ausgeben.
        echo '<div class="km271-card-value">' . $formatValue($item) . '</div>';
        if (!empty($item['Datum'])) {
            $datum = new \DateTimeImmutable($item['Datum']);
            echo '<time datetime="' . $escape($datum->format('c')) . '">';
            echo $escape($datum->format('d.m.Y H:i'));
            echo '</time>';
        }
        echo '</article>';
    }
};


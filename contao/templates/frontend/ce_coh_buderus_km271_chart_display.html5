$allSensors = $this->allSensors ?? [];
$orderedSensors = [];
foreach ($Sensorwerte as $key => $settings) {
    if (isset($allSensors[$key])) {
        $orderedSensors[$key] = $allSensors[$key];
    }
}


?>
        <?php
            echo "<section class='coh-panel km271-panel' id='km271-panel-"  . $escape($this->id) . "'>";
                echo "<div class='coh-stack'>";
                    if (!empty($this->headline)) {
                        $tag = $escape($this->hl ?: 'h3');
                        echo '<' . $tag . '>' . $escape($this->headline) . '</' . $tag . '>';
                    }
                    if ($this->sensorError) {
                        echo '<p class="km271-message is-error">' . $escape($this->sensorError) . '</p>';
                    } elseif ($orderedSensors === []) {
                        echo '<p class="km271-message">Noch keine KM271-Werte empfangen.</p>';
                    } else {
                        echo '<section class="coh-card km271-section">';
                        echo '<h3 class="coh-card-title">Heizungswerte</h3>';
                        echo '<div class="coh-mini-grid km271-grid">';
                        $renderCards($orderedSensors, $Sensorwerte);
                        echo '</div>';
                        echo '</section>';
                    }
                echo '</div>';
            $faultClass = '';
            $faultText = '';
            if (!empty($this->hasActiveFault)) {
                $faultClass = ' has-fault';
                $faultText = ' – Störung aktiv';
            }
            echo '<details class="coh-toggle km271-faults' . $faultClass . '">';
                echo '<summary>Störungen Heizung' . $faultText . '</summary>';
                echo '<div class="coh-mini-grid km271-grid">';
                    $renderCards($this->faultValues ?? [], $Sensorwerte);
                echo '</div>';
            echo '</details>';
    ?>

    <?php if (!empty($this->writeEnabled) && $catalog !== []): ?>
        <dialog class="km271-dialog" id="km271-dialog-<?= $escape($this->id) ?>">
            <button type="button" class="km271-dialog-close" data-km271-close aria-label="Dialog schließen">×</button>
            <h3 id="km271-dialog-title-<?= $escape($this->id) ?>">KM271-Einstellung ändern</h3>

            <?php if ($this->writeError): ?>
                <p class="km271-message is-error"><?= $escape($this->writeError) ?></p>
            <?php endif; ?>

            <?php if ($result !== null): ?>
                <div class="km271-message is-success" data-km271-result>
                    <strong>Schreibauftrag vom KM271 bestätigt</strong>
                    <p><?= $escape($result['LokaleId'] ?? '') ?> wurde auf <?= $escape($result['Wert'] ?? '') ?> <?= $escape($result['Einheit'] ?? '') ?> gesetzt.</p>
                    <p>Die Anzeige des aktuellen Sensorwertes wird beim nächsten Lesezyklus aktualisiert (derzeit alle <?= (int) $this->pollTimeMinutes ?> Minuten).</p>
                </div>
            <?php endif; ?>

            <form method="post" class="km271-dialog-form" data-km271-preview-form>
                <input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->requestToken ?? '') ?>">
                <input type="hidden" name="km271_element_id" value="<?= $escape($this->id) ?>">
                <input type="hidden" name="km271_action" value="preview">
                <input type="hidden" name="km271_lokale_id" value="<?= $escape($selected) ?>" data-km271-local-id>
                <p><strong data-km271-label><?= $escape($catalog[$selected]['Bezeichnung'] ?? $selected) ?></strong></p>
                <p>Aktueller Wert: <strong data-km271-current>–</strong></p>
                <label>
                    <span>Neuer Wert</span>
                    <span data-km271-input></span>
                </label>
                <button type="submit" class="km271-button">Auftrag prüfen</button>
            </form>

                <?php if ($preview !== null && $result === null): ?>
                    <div class="km271-preview" data-km271-preview>
                        <strong>Vorschau erfolgreich</strong>
                        <dl>
                            <dt>Einstellung</dt><dd><?= $escape($preview['LokaleId'] ?? '') ?></dd>
                            <dt>Neuer Wert</dt><dd><?= $escape($preview['Wert'] ?? '') ?> <?= $escape($preview['Einheit'] ?? '') ?></dd>
                            <dt>Codierung</dt><dd><code><?= $escape($preview['Hex'] ?? '') ?></code></dd>
                        </dl>
                        <form method="post" onsubmit="return window.confirm('Diesen Wert wirklich an das KM271 senden?');">
                            <input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->requestToken ?? '') ?>">
                            <input type="hidden" name="km271_element_id" value="<?= $escape($this->id) ?>">
                            <input type="hidden" name="km271_action" value="execute">
                            <input type="hidden" name="km271_lokale_id" value="<?= $escape($preview['LokaleId'] ?? '') ?>">
                            <input type="hidden" name="km271_wert" value="<?= $escape($preview['Wert'] ?? '') ?>">
                            <label class="km271-confirm"><input type="checkbox" name="km271_confirm" value="1" required> Schreibauftrag ausdrücklich bestätigen</label>
                            <button type="submit" class="km271-button is-danger">Jetzt an KM271 senden</button>
                        </form>
                    </div>
                <?php endif; ?>
        </dialog>

        <script>
        (() => {
            const dialog = document.getElementById(<?= json_encode('km271-dialog-' . $this->id) ?>);
            if (!dialog) return;
            const catalog = <?= json_encode($catalog, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
            const selected = <?= json_encode($selected, JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
            const inputValue = <?= json_encode((string) ($this->writeInput ?? ''), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
            const form = dialog.querySelector('[data-km271-preview-form]');

            function configure(localId, label, current, wantedValue = '') {
                if (!form || !catalog[localId]) return;
                const definition = catalog[localId];
                form.querySelector('[data-km271-local-id]').value = localId;
                form.querySelector('[data-km271-label]').textContent = label || definition.Bezeichnung || localId;
                form.querySelector('[data-km271-current]').textContent = current || '–';
                const host = form.querySelector('[data-km271-input]');
                host.replaceChildren();
                let input;
                if (Array.isArray(definition.Auswahl)) {
                    input = document.createElement('select');
                    definition.Auswahl.forEach(value => input.add(new Option(value, value, false, String(value) === String(wantedValue))));
                } else {
                    input = document.createElement('input');
                    input.type = 'number';
                    if (definition.Minimum !== undefined) input.min = definition.Minimum;
                    if (definition.Maximum !== undefined) input.max = definition.Maximum;
                    input.step = definition.Schrittweite ?? 1;
                    input.value = wantedValue || String(current).replace(',', '.').match(/-?\d+(?:\.\d+)?/)?.[0] || '';
                }
                input.name = 'km271_wert';
                input.required = true;
                host.append(input);
                if (definition.Einheit) host.append(' ' + definition.Einheit);
            }

            document.querySelectorAll('#km271-panel-<?= $escape($this->id) ?> [data-km271-edit]').forEach(button => {
                button.addEventListener('click', () => {
                    dialog.querySelector('[data-km271-result]')?.setAttribute('hidden', '');
                    dialog.querySelector('[data-km271-preview]')?.setAttribute('hidden', '');
                    configure(button.dataset.localId, button.dataset.label, button.dataset.current);
                    if (!dialog.open) dialog.showModal();
                });
            });
            dialog.querySelector('[data-km271-close]')?.addEventListener('click', () => dialog.close());
            dialog.addEventListener('click', event => {
                if (event.target === dialog) dialog.close();
            });
            if (selected) configure(selected, catalog[selected]?.Bezeichnung, '', inputValue);
            <?php if ($dialogActive): ?>dialog.showModal();<?php endif; ?>
        })();
        </script>
    <?php endif; ?>
</section>
